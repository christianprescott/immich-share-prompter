{
	"name": "immich-share-prompter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"worker:build": "vite build --config vite.worker.config.ts",
		"worker:run": "vite-node --config vite.worker.config.ts --options.transformMode.ssr='\\.svelte$' src/worker/testPrompt.ts",
		"worker": "node build-worker/entry.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.2.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-node": "^6.0.0"
	},
	"dependencies": {
		"@csstools/postcss-cascade-layers": "^6.0.0",
		"@immich/sdk": "^3.2.2",
		"@immich/ui": "^0.89.0",
		"absolutify": "^0.1.0",
		"croner": "^10.0.1",
		"juice": "^12.1.3",
		"lightningcss": "^1.30.2",
		"nodemailer": "^10.0.10",
		"postcss": "^8.5.28",
		"postcss-custom-properties": "^14.0.6"
	}
}
